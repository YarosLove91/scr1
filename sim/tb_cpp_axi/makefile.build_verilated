###############################################################################
# Stage 2: Build the verilated model archives using the makefile
#          generated by Verilator (libV$(TOP).a, V$(TOP)__ALL.a,
#          libverilated.a with VCD + threads runtime)
###############################################################################
TOP         ?= scr1_top_axi
OUTPUT_DIR  ?= verilated

NUM_THREADS := $(shell nproc)
ifeq ($(NUM_THREADS), 0)
	NUM_THREADS := 2
else
	NUM_THREADS := $(shell echo "$$(( $(NUM_THREADS) - 2 ))")
endif

###############################################################################
# Rules
###############################################################################
.PHONY: all clean

all:
	$(MAKE) -C $(OUTPUT_DIR) -f V$(TOP).mk libV$(TOP) -j $(NUM_THREADS)

clean:
	-$(MAKE) -C $(OUTPUT_DIR) -f V$(TOP).mk clean
